# Secrets — never commit
.env
.env.local
.env.*.local

# Garmin tokens — by default live in ~/.garminconnect/, but ignore them here
# in case the user moves them inside the repo
.garminconnect/
**/garmin_tokens.json

# User data — never commit personal Garmin / training data
data/
reports/
docs/seed_history/

# Personal living docs (the public versions live in templates/)
/master_plan.md
/executed_volume.md
/plan_adjustments.md

# Personal athlete profile (template lives at profile.example.yml)
/profile.yml

# Generated dashboard HTML (regenerated by scripts/build_dashboard.py)
/dashboard.html

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local backups / pre-edit snapshots (anything tagged .backup-* or .before*)
*.backup-*
*.before
*.before-*
