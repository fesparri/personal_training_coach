# =============================================================================
# Training Coach — environment variables
# =============================================================================
# Copy this file to `.env` and fill in your real values. `.env` is gitignored.

# -----------------------------------------------------------------------------
# Garmin Connect — required
# -----------------------------------------------------------------------------
# Used by `scripts/garmin_auth_bootstrap.py` for the one-time SSO login that
# creates `~/.garminconnect/garmin_tokens.json`. After bootstrap, daily
# `garmin_sync.py` runs use the saved tokens and never touch SSO again.
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_password_here
